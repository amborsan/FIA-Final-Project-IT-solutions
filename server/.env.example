# Backend environment variables
# Copy this file to .env and adjust the values.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fia?schema=public"

# API port and host
PORT=3000
HOST=localhost

# Used for CORS in development. In production the SPA is served by Express.
CLIENT_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Set to "production" when deploying. This enables secure cookies and trust proxy.
NODE_ENV=development
